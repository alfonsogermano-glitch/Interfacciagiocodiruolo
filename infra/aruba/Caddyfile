:80 {
    root * /srv/hollowgate
    encode zstd gzip

    @health path /healthz
    respond @health "ok" 200

    @static path /assets/*
    header @static Cache-Control "public, max-age=31536000, immutable"

    @entry path / /index.html
    header @entry Cache-Control "no-cache, must-revalidate"

    try_files {path} /index.html
    file_server
}
