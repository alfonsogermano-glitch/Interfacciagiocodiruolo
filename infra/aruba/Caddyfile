:80 {
    root * /srv/hollowgate
    encode zstd gzip

    # Mutually exclusive handlers prevent SPA rewrite from swallowing /healthz.
    handle /healthz {
        respond "ok" 200
    }

    handle {
        @static path /assets/*
        header @static Cache-Control "public, max-age=31536000, immutable"

        @entry path / /index.html
        header @entry Cache-Control "no-cache, must-revalidate"

        try_files {path} /index.html
        file_server
    }
}
