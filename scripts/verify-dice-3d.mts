const baseCustom=group('custom',6,[2,5]);const customGroup:RollDiceGroup={...baseCustom,customDieId:'custom',customDieName:'Custom',customDieSnapshot:snap,rolls:baseCustom.rolls.map((r,i)=>({...r,customDieId:'custom',customFace:snap.faces[i?4:1],physicalRole:'single',logicalRollIndex:i,contribution:null})),contribution:null};const projected=projectRollTo3D(result([customGroup]));assert.deepEqual(projected.map(c=>c.values),[[2],[5]]);assert.ok(projected.every(c=>c.customMaterials?.[0]?.customDie.id==='custom'));assert.ok(projected.every(c=>c.appearances?.[0]?.appearance.skinId==='fire'&&c.appearances?.[0]?.custom===true));
const imageSnap:CustomDieRollSnapshot={...snap,id:'image-custom',faces:snap.faces.map((face,index)=>index===0?{...face,visual:{kind:'image' as const,assetPath:'p',publicUrl:'https://example.invalid/image.webp'}}:face)};const imageBase=group('image-custom',6,[1]);const imageGroup:RollDiceGroup={...imageBase,customDieId:imageSnap.id,customDieSnapshot:imageSnap,rolls:imageBase.rolls.map(r=>({...r,customDieId:imageSnap.id,customFace:imageSnap.faces[0],physicalRole:'single' as const,logicalRollIndex:0,contribution:null})),contribution:null};assert.equal(projectRollTo3D(result([imageGroup]))[0]?.appearances?.[0]?.preserveFaceColors,true);
const d4Snap:CustomDieRollSnapshot={...snap,id:'custom-d4',sides:4,faces:Array.from({length:4},(_,i)=>({index:i+1,role:'single' as const,visual:{kind:'icon' as const,iconName:'Star'},numericValue:null}))};const d4Rolls=group('custom-d4',4,[3]).rolls.map(r=>({...r,customDieId:'custom-d4',customFace:d4Snap.faces[2],physicalRole:'single' as const,logicalRollIndex:0,contribution:null}));const customD4Group:RollDiceGroup={itemId:'custom-d4',sides:4,requestedQuantity:1,rolls:d4Rolls,activeRollIds:d4Rolls.map(r=>r.id),contribution:null,customDieId:'custom-d4',customDieName:'Custom d4',customDieSnapshot:d4Snap};const customD4Projected=projectRollTo3D(result([customD4Group]));assert.deepEqual(customD4Projected.map(c=>c.notation),['1d4@3']);assert.equal(customD4Projected[0]?.customMaterials?.[0]?.customDie.id,'custom-d4');
const d100Snap:CustomDieRollSnapshot={...snap,id:'p',sides:100,faces:[...Array.from({length:10},(_,i)=>({index:i+1,role:'tens' as const,visual:{kind:'icon' as const,iconName:'Star'},numericValue:null})),...Array.from({length:10},(_,i)=>({index:i+1,role:'units' as const,visual:{kind:'icon' as const,iconName:'Star'},numericValue:null}))]};const pair:RollDiceGroup={itemId:'p',sides:100,requestedQuantity:1,rolls:[{id:'t',groupItemId:'p',sides:100,face:4,contribution:null,active:true,source:'base',explosionDepth:0,chainId:'c',customDieId:'p',customFace:d100Snap.faces[3],physicalRole:'tens',logicalRollIndex:0},{id:'u',groupItemId:'p',sides:10,face:7,contribution:null,active:true,source:'base',explosionDepth:0,chainId:'c',customDieId:'p',customFace:d100Snap.faces[16],physicalRole:'units',logicalRollIndex:0}],activeRollIds:['t','u'],contribution:null,customDieId:'p',customDieSnapshot:d100Snap};assert.deepEqual(projectRollTo3D(result([pair])).map(c=>c.notation),['1d100@40','1d10@7']);
