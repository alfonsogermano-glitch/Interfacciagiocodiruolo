function group(itemId:string,sides:number,faces:number[],appearance?:DiceAppearance):RollDiceGroup{const rolls=faces.map((face,index)=>({id:`${itemId}-${index}`,groupItemId:itemId,sides,face,contribution:face,active:true,source:'base' as const,explosionDepth:0,chainId:`${itemId}-${index}`}));return{itemId,sides,requestedQuantity:faces.length,rolls,activeRollIds:rolls.map(r=>r.id),contribution:faces.reduce((a,b)=>a+b,0),appearance}}
