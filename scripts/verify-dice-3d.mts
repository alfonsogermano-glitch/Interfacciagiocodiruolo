assert.ok(renderer.includes("await import('@3d-dice/dice-box-threejs')"));assert.equal((renderer.match(/this\.box\.roll\(/g)??[]).length,1);assert.ok(renderer.includes('installDiceAppearanceAdapter'));assert.ok(renderer.includes('installCustomDiceMaterialAdapter'));assert.ok(renderer.indexOf('installDiceAppearanceAdapter')<renderer.indexOf('installCustomDiceMaterialAdapter'),'appearance adapter must be installed before the Custom label adapter');assert.ok(renderer.includes('installDice3DSpinAdapter(box)'));assert.ok(renderer.includes('strength: DICE_3D_THROW_STRENGTH'));assert.ok(renderer.includes('finally'));assert.ok(renderer.includes("signal.addEventListener('abort', stopEffectsOnAbort, { once: true })")&&renderer.includes("signal.removeEventListener('abort', stopEffectsOnAbort)"),'skin effect lifecycle must stop immediately on abort');
assert.ok(materials.includes('ICON_DATA'));assert.ok(materials.includes('physicalSides === 4'));assert.ok(materials.includes('buildSimultaneousMaterialQueue'));assert.ok(materials.includes('swapDiceFace_D4'),'custom d4 must keep the upstream forced-face material remap interception');assert.ok(materials.includes('customD4Meshes = new WeakMap'),'custom d4 forced remap must retain per-mesh descriptors');assert.ok(materials.includes('originalSetMaterialInfo?.();'),'custom d4 forced remap must rebuild valid randomized material state');assert.ok(materials.includes('applyCustomFactoryMaterialState(typedFactory, ready.descriptor)'),'custom d4 forced remap must reapply its exact custom colors/textures');
assert.ok(appearance.includes('buildSimultaneousAppearanceQueue'));assert.ok(appearance.includes('getDice3DTextureDescriptor(appearance)'));assert.ok(appearance.includes("console.error('Texture skin 3D non disponibile, uso il materiale neutro:'"),'skin texture failures must fall back to neutral material');assert.ok(appearance.includes('descriptor.preserveFaceColors'),'appearance adapter must not emissively tint uploaded Custom image faces');assert.ok(appearance.includes('swapDiceFace_D4'),'general appearance must survive d4 forced-result remaps');
