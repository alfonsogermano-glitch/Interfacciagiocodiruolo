const simple=projectRollTo3D(result([group('d20',20,[17,4])]));assert.deepEqual(simple.map(c=>({sides:c.sides,values:c.values,notation:c.notation})),[{sides:20,values:[17,4],notation:'2d20@17,4'}]);
const standard=projectRollTo3D(result([group('d4',4,[3]),group('d6',6,[6]),group('d8',8,[7]),group('d10',10,[9]),group('d12',12,[11]),group('d20',20,[19]),group('d100',100,[73])]));assert.deepEqual(standard.map(c=>c.notation),['1d4@3','1d6@6','1d8@7','1d10@9','1d12@11','1d20@19','1d100@70','1d10@3']);
