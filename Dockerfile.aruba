# Stage 1: build the existing Hollowgate React/Vite client.
FROM node:22.16.0-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# Stage 2: static SPA, independent of Vercel runtime.
FROM caddy:2.10.0-alpine
COPY infra/aruba/Caddyfile /etc/caddy/Caddyfile
COPY --from=builder /app/dist /srv/hollowgate
EXPOSE 80
